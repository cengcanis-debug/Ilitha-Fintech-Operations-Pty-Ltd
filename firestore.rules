rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /certificates/{document} {
      allow read, write: if true;
    }
    match /signed_documents/{document} {
      allow read, write: if true;
    }
    match /partner_registrations/{document} {
      allow read, write: if true;
    }
    match /developer_ip_manifests/{document} {
      allow read, write: if true;
    }
  }
}
